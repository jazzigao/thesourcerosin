{
  "expo": {
    "name": "The Source",
    "slug": "the-source-mobile",
    "version": "1.0.0",
    "description": "Shop The Source's curated cannabis products and complete payment through secure Shopify checkout.",
    "orientation": "portrait",
    "icon": "./assets/images/the-source-brand.png",
    "scheme": "the-source-mobile",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#17352b",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/the-source-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f3ef"
    },
    "ios": {
      "bundleIdentifier": "com.thesource.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thesource.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/the-source-brand.png",
        "backgroundColor": "#f5f3ef"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/images/the-source-brand.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
